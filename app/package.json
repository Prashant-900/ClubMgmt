{
  "name": "clubmgmt-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "ClubMgmt React Native app (bare workflow, no Expo)",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pods": "cd ios && pod install && cd ..",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-gesture-handler": "^2.29.0",
    "react-native-inappbrowser-reborn": "^3.7.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/runtime": "^7.28.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/metro-config": "0.85.0",
    "@react-native/typescript-config": "0.85.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.36.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
